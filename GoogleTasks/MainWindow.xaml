<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GoogleTasks.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GoogleTasks"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    xmlns:converters="using:GoogleTasks.Converters">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">

        <Grid.Resources>
            <converters:RelativeDateConverter x:Key="RelativeDateConverter"/>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <!-- HUB TITLE BAR -->
        <Grid x:Name="DragRegion" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="0" Background="Transparent">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- New List -->
            <Button Background="Transparent" x:Name="AddButton" ToolTipService.ToolTip="New List" Grid.Column="0" VerticalAlignment="Stretch" Width="40" CornerRadius="0" Padding="0" Margin="0,1,0,0" BorderThickness="0" Click="AddList">
                <Button.Content>
                    <FontIcon Foreground="{ThemeResource SystemBaseMediumLowColor}" Glyph="&#xE710;" FontSize="18" />
                </Button.Content>
            </Button>

            <!-- SYNC -->
            <ProgressBar IsHitTestVisible="False" Visibility="Collapsed" x:Name="ProgressBar" VerticalAlignment="Top" Height="5" ShowPaused="False" ShowError="False" IsIndeterminate="True" Grid.ColumnSpan="4"/>
            <Button Background="Transparent" x:Name="SyncButton" Click="SyncLists" ToolTipService.ToolTip="Sync Now" Grid.Column="1" VerticalAlignment="Stretch" Width="40" CornerRadius="0" Padding="0" Margin="0,1,0,0" BorderThickness="0">
                <Button.Content>
                    <FontIcon Foreground="{ThemeResource SystemBaseMediumLowColor}" Glyph="&#xE895;" FontSize="18" />
                </Button.Content>
            </Button>


            <!-- Test Startup -->
            <!--<Button Background="Transparent" x:Name="SettingsButton" Click="TestStartup_Click" ToolTipService.ToolTip="DEBUG STARTUP" Grid.Column="2" VerticalAlignment="Stretch" Width="40" CornerRadius="0" Padding="0" Margin="0,1,0,0" BorderThickness="0">
                <Button.Content>
                    <FontIcon Foreground="{ThemeResource SystemBaseMediumLowColor}" Glyph="T" FontSize="18" />
                </Button.Content>
            </Button>-->

            <!-- Settings -->
            <Button Background="Transparent" x:Name="SettingsButton" Click="LaunchSettings" ToolTipService.ToolTip="Settings" Grid.Column="2" VerticalAlignment="Stretch" Width="40" CornerRadius="0" Padding="0" Margin="0,1,0,0" BorderThickness="0">
                <Button.Content>
                    <FontIcon Foreground="{ThemeResource SystemBaseMediumLowColor}" Glyph="&#xE713;" FontSize="18" />
                </Button.Content>
            </Button>


            <!-- CLOSE BUTTON -->
            <Button Background="Transparent" x:Name="CloseButton" ToolTipService.ToolTip="Close Hub" Grid.Column="3" VerticalAlignment="Stretch" Width="40" CornerRadius="0" Padding="0" Margin="0,1,0,0" BorderThickness="0" Click="CloseApp">
                <Button.Content>
                    <FontIcon Foreground="{ThemeResource SystemBaseMediumLowColor}" Glyph="&#xE711;" FontSize="18" />
                </Button.Content>
            </Button>

        </Grid>

        <Grid Padding="12,0,12,0" Grid.Row="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Vertical" Spacing="8">
                <TextBlock Text="Google Tasks" FontWeight="ExtraBold" FontSize="20"/>
                <AutoSuggestBox x:Name="SearchBox" PlaceholderText="Search..." TextChanged="SearchBox_TextChanged" QueryIcon="Find" QuerySubmitted="SearchBox_QuerySubmitted"/>
            </StackPanel>

            <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.Row="1">
                <ListView CanReorderItems="False" CanDragItems="False" AllowDrop="False" x:Name="ListsCollection" ItemsSource="{x:Bind FilteredLists, Mode=OneWay}" SelectionMode="None" CornerRadius="0" IsItemClickEnabled="False" BorderThickness="0" Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,4,0,4"/>
                            <Setter Property="Background" Value="Transparent"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Button BorderBrush="{ThemeResource ControlElevationBorderBrush}" PointerEntered="ListCollectionItem_PointerEntered" PointerExited="ListCollectionItem_PointerExited" HorizontalContentAlignment="Stretch" BorderThickness="1" Padding="0" Background="Transparent" HorizontalAlignment="Stretch" Tapped="PopOutList" Tag="{Binding}">
                                <Grid MinHeight="60">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="1"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- BACKPLATE -->
                                    <Grid Grid.ColumnSpan="5" x:Name="Backplate" Background="{ThemeResource CollectionBackPlate}">

                                        <!-- TODO: Corner turn effect for open windows-->
                                        <!--<Path x:Name="Twirl" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="24" Height="24" Fill="{ThemeResource SystemControlBackgroundBaseLowBrush}" Data="M 10,10 L 24,10 L 10,24 Z"/>
                                        <Path x:Name="BackSide" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="24" Fill="{ThemeResource SystemControlBackgroundAltMediumHighBrush}" Data="M 0,24 L 24,0 L 24,24 Z"/>-->
                                    </Grid>

                                    <!--<Rectangle  Translation="-4,0,0" Grid.Column="0" VerticalAlignment="Stretch" HorizontalAlignment="Left" Width="3" IsHitTestVisible="False">
                                        <Rectangle.TranslationTransition>
                                            <Vector3Transition Duration="0:0:0.2"/>
                                        </Rectangle.TranslationTransition>
                                    </Rectangle>-->
                                    
                                    <!-- Colored Border -->
                                    <Border Margin="-0.5" Opacity="0" CornerRadius="2" x:Name="ColorStrip" IsHitTestVisible="False" Grid.ColumnSpan="5" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" BorderThickness="2">
                                        <Border.OpacityTransition>
                                            <ScalarTransition Duration="0:0:0.1"/>
                                        </Border.OpacityTransition>
                                        <Rectangle IsHitTestVisible="False" Opacity="0.1" Fill="{ThemeResource AccentFillColorDefaultBrush}"/>
                                    </Border>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Vertical">
                                        <TextBlock Margin="8" HorizontalAlignment="Center" MaxLines="3" ToolTipService.ToolTip="{Binding Title, Mode=OneWay}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" TextAlignment="Center" FontWeight="Bold" Text="{Binding Title, Mode=OneWay}"/>
                                    </StackPanel>

                                    <Rectangle Grid.Column="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Fill="{ThemeResource SystemBaseLowColor}" Margin="0,6,0,6"/>

                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="2" Orientation="Vertical">
                                        <TextBlock VerticalAlignment="Center" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Text="{Binding PendingCount, Mode=TwoWay}"/>
                                        <TextBlock VerticalAlignment="Center" Opacity="0.8" FontSize="9" Text="pending" HorizontalAlignment="Center"/>
                                    </StackPanel>

                                    <Rectangle Grid.Column="3" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Fill="{ThemeResource SystemBaseLowColor}" Margin="0,6,0,6"/>

                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="4" Orientation="Vertical">
                                        <TextBlock VerticalAlignment="Center" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" Text="{Binding Updated, Mode=OneWay, Converter={StaticResource RelativeDateConverter}}"/>
                                        <TextBlock VerticalAlignment="Center" Opacity="0.8" FontSize="9" Text="last modified" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                                <Button.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Icon="Edit" Tag="{Binding}" Text="Rename" Click="RenameList"/>
                                        <MenuFlyoutItem Icon="Delete" Tag="{Binding}" Text="Delete" Click="DeleteList"/>
                                    </MenuFlyout>
                                </Button.ContextFlyout>
                            </Button>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </ScrollViewer>
        </Grid>

        <Grid Padding="20" BorderBrush="{ThemeResource SystemBaseLowColor}" BorderThickness="0,1,0,0" Translation="0,5000,0" Grid.Row="1" x:Name="SettingsOverlay" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.TranslationTransition>
                <Vector3Transition Duration="0:0:0.2"/>
            </Grid.TranslationTransition>
            <StackPanel Orientation="Vertical" Spacing="16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Click="LaunchSettings" ToolTipService.ToolTip="Go Back" Padding="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" VerticalAlignment="Center">
                        <Button.Content>
                            <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                        </Button.Content>
                    </Button>
                    <TextBlock VerticalAlignment="Center" Text="Settings" FontWeight="ExtraBold" FontSize="20"/>
                </StackPanel>

                <Grid Visibility="Collapsed" Padding="8,0,8,0" Height="60" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefault}" Background="{ThemeResource CardBackgroundFillColorDefault}" CornerRadius="{ThemeResource ControlCornerRadius}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE706;" Grid.Column="0"/>
                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center" Orientation="Vertical" Grid.Column="1" Spacing="2">
                        <TextBlock Text="Application Theme" FontSize="12"/>
                        <TextBlock Text="Switch between dark/light themes" FontSize="10" Opacity="0.8"/>
                    </StackPanel>
                    <ComboBox HorizontalAlignment="Right" Margin="0,0,6,0" Grid.Column="2" VerticalAlignment="Center" VerticalContentAlignment="Center" x:Name="ThemeComboBox" SelectedIndex="0" SelectionChanged="ThemeComboBox_SelectionChanged">
                        <ComboBoxItem Content="System"/>
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark"/>
                    </ComboBox>
                </Grid>

                <!--- Set margin of below to 0,-10,0,0 -->
                <Grid Margin="0,0,0,0" Padding="8,0,8,0" Height="60" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefault}" Background="{ThemeResource CardBackgroundFillColorDefault}" CornerRadius="{ThemeResource ControlCornerRadius}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="0.75*"/>
                        <ColumnDefinition Width="0.25*"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon VerticalAlignment="Center" FontSize="18" Glyph="&#xE7E8;" Grid.Column="0"/>

                    <StackPanel Margin="8,0,0,0" VerticalAlignment="Center" Orientation="Vertical" Grid.Column="1" Spacing="2">
                        <TextBlock Text="Launch on startup" FontSize="12"/>
                        <TextBlock Text="Allow app to run automatically" FontSize="10" Opacity="0.8"/>
                    </StackPanel>
                    <ToggleSwitch HorizontalAlignment="Left"  x:Name="StartupToggle" Toggled="StartupSwitch_Toggled" VerticalAlignment="Center" FontSize="12" VerticalContentAlignment="Center" Grid.Column="2"/>
                </Grid>

            </StackPanel>
        </Grid>
    </Grid>
</Window>
