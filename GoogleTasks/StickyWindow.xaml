<Window
    x:Class="GoogleTasks.StickyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GoogleTasks"
    xmlns:converters="using:GoogleTasks.Converters">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" Background="{ThemeResource StickyBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="35"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="0"/>
        </Grid.RowDefinitions>
        
        <Grid.Resources>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:SubstringToBrushConverter x:Key="SubstringToBrushConverter"/>
        </Grid.Resources>

        <!-- STICKY NOTES TITLE BAR -->
        <Grid x:Name="DragRegion" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Grid.Row="0" Background="{ThemeResource AccentFillColorDefaultBrush}">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>


            <!-- Open Hub -->
            <Button Style="{ThemeResource AccentButtonStyle}" x:Name="HomeButton" ToolTipService.ToolTip="Open Hub Window" Grid.Column="0" VerticalAlignment="Stretch" Width="35" CornerRadius="0" Padding="0" Margin="0,1,0,0" BorderThickness="0" Click="OpenHubWindow">
                <Button.Content>
                    <FontIcon Glyph="&#xE80F;" FontSize="18" />
                </Button.Content>
            </Button>

            <StackPanel IsHitTestVisible="False" x:Name="StickyHeader" Spacing="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Grid.ColumnSpan="4">
                <TextBlock MaxWidth="150" ToolTipService.ToolTip="{x:Bind ListTitle.Text, Mode=TwoWay}" TextTrimming="CharacterEllipsis" x:Name="ListTitle"  Foreground="{ThemeResource SystemAltHighColor}" />
                <FontIcon Visibility="Collapsed" Foreground="{ThemeResource SystemAltHighColor}" Glyph="&#xE915;" FontSize="8"/>
                <TextBlock Visibility="Collapsed" x:Name="StatusText"  Foreground="{ThemeResource SystemAltHighColor}" Text=""/>
            </StackPanel>


            <!-- SYNC -->
            <Button Style="{ThemeResource AccentButtonStyle}" x:Name="MenuButton" Click="RefreshButton_Click" ToolTipService.ToolTip="Sync Now" Grid.Column="2" VerticalAlignment="Stretch" Width="35" CornerRadius="0" Padding="0" Margin="0,1,0,0" BorderThickness="0">
                <Button.Content>
                    <FontIcon Glyph="&#xE895;" FontSize="18" />
                </Button.Content>
            </Button>



            <!--<Button x:Name="MenuButton" ToolTipService.ToolTip="More" Grid.Column="1" VerticalAlignment="Stretch" Width="35" CornerRadius="0" Padding="0" Background="Transparent" Margin="0,1,0,0" BorderThickness="0">
                <Button.Content>
                    <FontIcon Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="&#xE712;" FontSize="18" />
                </Button.Content>
                <Button.Flyout>
                    <Flyout>
                        <StackPanel Padding="0" Spacing="8" Orientation="Vertical">

                            -->
            <!-- COLOR GRID -->
            <!--
                            <StackPanel Orientation="Horizontal" Spacing="0" x:Name="ColorGrid" HorizontalAlignment="Center">

                                -->
