                                <Button CornerRadius="4,0,0,4" Padding="0" Margin="0" BorderThickness="0" Width="40" Height="54" Background="#e6b904" Tag="255,230,185,4" Click="ColorSwatch_Click"/>
                                <Button CornerRadius="0" Padding="0" Margin="0" BorderThickness="0" Width="40" Height="54" Background="#65ba5a" Tag="255,101,186,90" Click="ColorSwatch_Click"/>
                                <Button CornerRadius="0" Padding="0" Margin="0" BorderThickness="0" Width="40" Height="54" Background="#ffa036" Tag="255,255,160,54" Click="ColorSwatch_Click"/>
                                <Button CornerRadius="0" Padding="0" Margin="0" BorderThickness="0" Width="40" Height="54" Background="#ea86c2" Tag="255,234,134,194" Click="ColorSwatch_Click"/>
                                <Button CornerRadius="0" Padding="0" Margin="0" BorderThickness="0" Width="40" Height="54" Background="#b07fe0" Tag="255,176,127,224" Click="ColorSwatch_Click"/>
                                <Button CornerRadius="0" Padding="0" Margin="0" BorderThickness="0" Width="40" Height="54" Background="#59c0e7" Tag="255,89,192,231" Click="ColorSwatch_Click"/>
                                <Button CornerRadius="0,4,4,0" Padding="0" Margin="0" BorderThickness="0" Width="40" Height="54" Background="#989898" Tag="255,152,152,152" Click="ColorSwatch_Click"/>
                                

                            </StackPanel>

                            <MenuFlyoutSeparator/>
                            <MenuFlyoutItem Margin="0" Text="Refresh" Click="RefreshButton_Click" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>-->

            <!-- CLOSE -->
            <Button Style="{ThemeResource AccentButtonStyle}" x:Name="CloseButton" ToolTipService.ToolTip="Exit" Grid.Column="3" VerticalAlignment="Stretch" Width="35" CornerRadius="0" Padding="0" Margin="0,1,0,0" BorderThickness="0" Click="CloseButton_Click">
                <Button.Content>
                    <FontIcon Glyph="&#xE711;" FontSize="18" />
                </Button.Content>
            </Button>

        </Grid>


        <!-- TASK LIST -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.Row="1">
            <StackPanel Padding="0,0,0,76" Orientation="Vertical">
                <Expander Padding="16,4,16,10" Margin="8,12,12,0" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ExpandDirection="Down" VerticalAlignment="Top">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="0">
                            <TextBlock FontWeight="SemiBold" Text="Pending ("/>
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind Tasks.Count, Mode=OneWay}"/>
                            <TextBlock Text=")" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Expander.Header>
                    <Expander.Content>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">

                            <ListView Margin="0,12,0,0" CanReorderItems="False" CanDragItems="False" AllowDrop="False" x:Name="TaskList" ItemsSource="{x:Bind Tasks}" SelectionMode="None" CornerRadius="0" IsItemClickEnabled="False" BorderThickness="0" Background="Transparent">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:TaskItem">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <!-- Completion checkbox -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- Task content -->
                                            </Grid.ColumnDefinitions>

                                            <CheckBox ToolTipService.ToolTip="Mark as complete" Grid.Column="0" Width="30" Margin="-8,0,0,0" Height="30" VerticalAlignment="Top" HorizontalAlignment="Center" Style="{ThemeResource TaskCheckBoxStyle}" Checked="TaskCheckBox_Checked"/>

                                            <Grid Grid.Column="1" Margin="10,0,0,0">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- TEXT / STATUS CONTENT -->
                                                <StackPanel Margin="0,5,16,0" Grid.Column="0" Orientation="Vertical" Spacing="2">
                                                    <TextBlock MaxLines="5" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" Text="{x:Bind Title}" TextWrapping="Wrap"/>
                                                    <TextBlock MaxLines="5" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Notes}" FontStyle="Italic" Margin="0,-1,0,0" Visibility="{Binding Notes, Converter={StaticResource StringToVisibilityConverter}}" Text="{x:Bind Notes}" FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
                                                    <StackPanel Margin="0,1,0,0" Visibility="{Binding DueDate_UIFriendlyText, Converter={StaticResource StringToVisibilityConverter}}" Orientation="Horizontal" Spacing="5">
                                                        <FontIcon FontWeight="SemiBold" Margin="0,1.5,0,0" FontSize="10" Glyph="&#xED5A;" Foreground="{Binding DueDate_UIFriendlyText, Converter={StaticResource SubstringToBrushConverter}}"/>
                                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind DueDate_UIFriendlyText}" FontSize="9" Foreground="{Binding DueDate_UIFriendlyText, Converter={StaticResource SubstringToBrushConverter}}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <!-- STAR -->
                                                <CheckBox Visibility="Collapsed" Grid.Column="1" Width="30" Height="30" VerticalAlignment="Top" HorizontalAlignment="Center" Style="{ThemeResource StarCheckBoxStyle}" x:Name="StarredCheckbox" IsChecked="{Binding IsStarred, Mode=TwoWay}"/>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>
                    </Expander.Content>
                </Expander>

                <Expander Visibility="Collapsed" x:Name="CompletedExpander" Padding="16,4,16,10" Margin="8,12,12,0" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" ExpandDirection="Down"  VerticalAlignment="Top">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal" Spacing="0">
                            <TextBlock FontWeight="SemiBold" Text="Completed ("/>
                            <TextBlock FontWeight="SemiBold" Text="{x:Bind CompletedTasks.Count, Mode=OneWay}"/>
                            <TextBlock FontWeight="SemiBold" Text=")"/>
                        </StackPanel>
                    </Expander.Header>
                    <Expander.Content>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ListView CanReorderItems="False" CanDragItems="False" AllowDrop="False" x:Name="CompletedTaskList" ItemsSource="{x:Bind CompletedTasks}" SelectionMode="None" CornerRadius="0" IsItemClickEnabled="False" BorderThickness="0" Background="Transparent">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <!--<ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:TaskItem">
                                        <CheckBox IsChecked="True" IsHitTestVisible="False"  HorizontalAlignment="Stretch">
                                            <CheckBox.Content>
                                                <StackPanel Orientation="Vertical" Margin="10,0,0,0" Spacing="2">
                                                    <TextBlock Text="{x:Bind Title}" TextDecorations="Strikethrough" Opacity="0.8" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{x:Bind CompletedDate_UIFriendlyText}" Opacity="0.8" TextWrapping="Wrap"/>
                                                    --><!--<StackPanel Visibility="Collapsed" Orientation="Horizontal" Spacing="5">
                                                        <FontIcon Margin="0,1.5,0,0" FontSize="10" Glyph="&#xED5A;" Foreground="{ThemeResource SystemErrorTextColor}"/>
                                                        <TextBlock Text="{x:Bind DueDate_UIFriendlyText}" FontSize="9" Foreground="{ThemeResource SystemErrorTextColor}"/>
                                                    </StackPanel>--><!--
                                                </StackPanel>
                                            </CheckBox.Content>
                                        </CheckBox>
                                    </DataTemplate>
                                </ListView.ItemTemplate>-->
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:TaskItem">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="30"/>
                                                <!-- Completion checkbox -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- Task content -->
                                            </Grid.ColumnDefinitions>

                                            <CheckBox IsChecked="True" IsHitTestVisible="False" Grid.Column="0" Width="30" Margin="-8,0,0,0" Height="30" VerticalAlignment="Top" HorizontalAlignment="Center" Style="{ThemeResource TaskCheckBoxStyle}"/>

                                            <Grid Grid.Column="1" Margin="10,0,0,0">

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="30"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- TEXT / STATUS CONTENT -->
                                                <StackPanel Margin="0,5,16,0" Grid.Column="0" Orientation="Vertical" Spacing="2">
                                                    <TextBlock Opacity="0.75" TextDecorations="Strikethrough" MaxLines="5" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" Text="{x:Bind Title}" TextWrapping="Wrap"/>
                                                    <TextBlock TextTrimming="CharacterEllipsis" Margin="0,-1,0,0" FontSize="12" Opacity="0.75" Text="{x:Bind CompletedDate_UIFriendlyText}" TextWrapping="Wrap"/>
                                                    <!--<TextBlock MaxLines="5" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Notes}" FontStyle="Italic" Margin="0,-1,0,0" Visibility="{Binding Notes, Converter={StaticResource StringToVisibilityConverter}}" Text="{x:Bind Notes}" FontSize="12" Opacity="0.75" TextWrapping="Wrap"/>
                                                    <StackPanel Margin="0,1,0,0" Visibility="{Binding DueDate_UIFriendlyText, Converter={StaticResource StringToVisibilityConverter}}" Orientation="Horizontal" Spacing="5">
                                                        <FontIcon FontWeight="SemiBold" Margin="0,1.5,0,0" FontSize="10" Glyph="&#xED5A;" Foreground="{Binding DueDate_UIFriendlyText, Converter={StaticResource SubstringToBrushConverter}}"/>
                                                        <TextBlock FontWeight="SemiBold" Text="{x:Bind DueDate_UIFriendlyText}" FontSize="9" Foreground="{Binding DueDate_UIFriendlyText, Converter={StaticResource SubstringToBrushConverter}}"/>
                                                    </StackPanel>-->
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>
                    </Expander.Content>
                </Expander>
            </StackPanel>

        </ScrollViewer>
        
        


        <!-- ADD TASK -->
        <Button ToolTipService.ToolTip="New" VerticalAlignment="Bottom" Margin="0,0,13,12" Grid.Row="1" Height="54" HorizontalAlignment="Right" Width="54" CornerRadius="8" Padding="0" Style="{ThemeResource AccentButtonStyle}" BorderThickness="0" Click="AddTaskButton_Click">
            <Button.Content>
                <FontIcon Glyph="&#xE710;" FontSize="18" />
            </Button.Content>
        </Button>

